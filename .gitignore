# Compiled binaries
bin/
kobo-vocab/kobo-vocab
# `go build ./...` drops a binary named after each main package, either in
# the package directory or the cwd it was run from - catch both so they
# can't be committed by accident
cmd/fbink/fbink
cmd/server/server
cmd/apkgimport/apkgimport
/fbink
/server
/apkgimport

# build.sh's self-bootstrapped cross-compiler (downloaded on first build, not
# vendored)
.build-tools/

# Deployment zips
*.zip

# Dictionaries (large, user-specific)
dict/
kobo-vocab/dict/
kobo-vocab/kobodict/

# Real Anki decks used for manual apkgimport testing - large, third-party,
# not test fixtures this repo's own tests read
test-apkgs/

# User data
words/
*.csv
# apkg-imported decks' media (images, and the archived source .apkg)
*.media/
# ...except the sample deck, so a fresh clone is runnable out of the box
!french.csv
*.sqlite

# Logs
*.log

# Config files (examples are tracked instead)
anki-core.conf
anki-fbink.conf
anki-mywords.conf
anki-apkgimport.conf
kobo-vocab/vocab.conf
deploy.conf

# API credentials
APIs/
