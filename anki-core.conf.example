# Shared core configuration (used by both fbink and server binaries)
data_dir=words
reverse=false

# FSRS tuning.
# request_retention: the probability of recall you are scheduling for. Higher
#   means shorter intervals and more reviews.
# maximum_interval: the longest gap FSRS may schedule, in days.
request_retention=0.9
maximum_interval=36500

# Learning steps. With this on, a new word is answered twice in one sitting
# before it gets a real interval (Good -> ten minutes -> Good -> a few days),
# and a lapsed word gets one extra look before going back on schedule. Those
# repeats are handed over immediately by the review queue, so the minutes
# never cost any actual waiting - see step_gap below.
#
# Turning it off gives one look per card per day. Repeats within a day then
# earn nothing: FSRS derives recall stability from how long you went without
# seeing the card, and over zero elapsed days that gain is exactly zero - so
# a Good right after an Again gives back none of what the Again took away.
enable_short_term=true

# Learning mode: trickle new words into a sitting instead of dumping a
# freshly generated deck on you all at once.
#
# learning_pool is how many never-seen words may be in progress at once -
# admitted but not yet graduated to a real interval. That is its only job -
# it does not touch reviews (every due review is always shown,
# unconditionally). A word keeps its slot from admission until it graduates:
# under short-term learning steps that can take two or more ratings, so the
# pool caps what you're actively juggling, not just first exposures. Once a
# slot frees, the next word waiting comes in, same sitting - so the pool only
# paces arrival, and by the end of a sitting every due word, seen or not, has
# been shown at least once. 0 turns the gate off and admits every new word at
# once.
#
# step_gap is how many other cards are shown before one you rated Again - or
# one still mid-learning-step - comes back. It is a target, not a promise:
# with fewer cards than that left, it goes to the end of the sitting instead.
learning_pool=10
step_gap=3

# Multiplier layered on top of each binary's own baseline correction for an
# html/apkg card's literal CSS font sizes (real Anki templates assume a
# normal ~96-160 DPI phone/desktop screen, tiny otherwise - this is true in
# every browser cmd/server has been tested in, not just on the Kobo panel).
# 1.0 means "accept that binary's baseline as-is": cmd/fbink's baseline is
# the real detected screen DPI/96; cmd/server has no per-viewer DPI to
# detect, so its baseline is a fixed assumption (serverBaselineScale in
# cmd/server/main.go) roughly matching a Kobo panel. Raise or lower this if
# that assumption is wrong for how you actually view server mode.
html_font_scale=1.0
