# kobo-vocab configuration
# Dictionary location - can be relative or absolute
# Examples:
#   dict_dir=dict                             (bundled with app)
#   dict_dir=/mnt/onboard/.kobo/custom-dict   (Kobo custom dicts)
#   dict_dir=/mnt/onboard/.kobo/dict          (Kobo built-in dicts)
dict_dir=dict
db=/mnt/onboard/.kobo/KoboReader.sqlite

# Where generated decks go. Normally leave this alone: it follows data_dir
# in anki-core.conf, which is where the flashcard app looks for them, so the
# location is set in exactly one place. Uncomment only to write decks
# somewhere else on purpose - if it disagrees with data_dir, kobo-vocab says
# so rather than quietly producing decks the app never shows.
# out=words

# Automatically run kobo-vocab in the background at every startup.
# Off by default — enable once you're happy with your dictionary setup,
# since it re-scans your Kobo's vocabulary list and dictionaries on boot.
auto_parse=false

# Definition length controls, for dictionaries with rich/nested entries
# (multiple senses, example sentences, etc.):
#   max_senses=1   how many senses (<li> entries) to include per word
#   max_depth=1    how many direct sub-blocks to keep within each sense —
#                  the first is always the core gloss; a second is usually
#                  an example-sentence block, so max_depth=1 drops examples
#   max_chars=150  hard cap on definition length as a safety net
max_senses=1
max_depth=1
max_chars=150

# Content providers to try, in order, for each word - the first one that
# finds something wins. Built-in providers:
#   dict       local dicthtml-*.zip files (see dict_dir above). Free,
#              instant, offline - keep this first.
#   lexicala   online dictionary API (lexicala.com via RapidAPI). Needs
#              credentials in APIs/lexicala.json (base_url + token, see
#              APIs/ directory - gitignored, never committed) and is
#              limited to ~50 calls/day, so it's meant as a fallback for
#              words the local dict misses, not a primary source.
#   mymemory   free machine-translation API, no credentials needed. Same
#              role as the old api_fallback=true setting.
#   chatgpt    LLM-generated card: headword (dictionary form) + a few
#              alternative meanings + one example sentence, on BOTH the
#              front (source language) and back (target language, a
#              translation of the same example) - see chatgpt_* below.
#              Needs credentials in APIs/chatgpt.json. Works with any
#              OpenAI-compatible Chat Completions endpoint, not just
#              OpenAI itself - see chatgpt_provider.go for details.
# Can also be set per-language below, overriding this default. Uncomment
# to try the online providers as a fallback once your dicts are set up:
# providers=dict,lexicala,mymemory,chatgpt
providers=dict

# CA bundle used for every network provider's TLS verification, appended to
# whatever the OS's own trust store provides (if any). Needed because some
# Kobo firmware ships with NO system CA store at all - on a device like
# that, every HTTPS request fails identically ("x509: certificate signed by
# unknown authority"), regardless of which provider or how valid its real
# certificate is. cacert.pem (repo root, a standard CA bundle - not a
# secret, safe to ship/commit) covers that case; only relevant if lexicala/
# mymemory/chatgpt are in providers= above, since dict never touches the
# network.
ca_cert=cacert.pem

# Only read if "lexicala" is in providers= above. Relative paths resolve
# against this config file's directory, same as dict_dir/db/out.
lexicala_conf=APIs/lexicala.json

# Only read if "chatgpt" is in providers= above. chatgpt_conf is the
# credentials file (base_url + token - see APIs/ directory, gitignored);
# everything else here is the actual "variables to build the request":
#   chatgpt_model             any OpenAI-compatible model id
#   chatgpt_temperature       0.0-2.0, lower = more deterministic/factual
#   chatgpt_max_tokens        hard cap on the completion length
#   chatgpt_max_alternatives  how many alternative meanings/translations
#                              to keep per card face (like Lexicala's
#                              top-N translations, applied to both faces)
chatgpt_conf=APIs/chatgpt.json
chatgpt_model=gpt-4o-mini
chatgpt_temperature=0.1
chatgpt_max_tokens=400
chatgpt_max_alternatives=3

# How the "themed" card faces (headword + alternatives + example) are laid
# out - shared by dict (when dict_examples=true), lexicala, and chatgpt, so
# it applies uniformly across every provider that builds one. Global only,
# no per-[lang] override (lexicala/chatgpt are built once and shared across
# every language pair in a run, so a per-language override would only ever
# take effect for whichever language happened to build them first).
#
# Placeholders: {head} {alts} {ex}. Wrap a chunk in [...] to drop it
# entirely - not just leave it blank - when every placeholder inside it is
# empty, e.g. "[\n{alts}]" disappears rather than leaving a stray blank line
# when a word has no alternatives. No nesting. "\n" inserts an actual line
# break (a config value is one physical line, so this is the only way to
# put one in) and "\\" a literal backslash; no other escaping. Keep
# separating punctuation/spaces/breaks INSIDE the brackets they belong to,
# not floating between two bracketed groups, or a dropped middle group can
# leave a double space (or blank line) behind (e.g. write
# "{head}[\n{alts}][\n*{ex}*]", not "{head} [{alts}]\n[{ex}]").
#
# The default below: bold headword, a line break, comma-joined alternatives,
# another line break, then the italic example - each on its own line, with
# any missing piece (no alternatives, no example) simply not leaving a line
# behind rather than an empty gap.
card_format=[**{head}**][\n\n{alts}][\n\n*{ex}*]

# Which annotations to remove from card text, for dictionaries whose entries
# carry them as typed classes (see CLASSES.md next to the dict extractor):
#   gen   (der), (het)      article / grammatical gender
#   gram  (4e naamval)      case, verb type, number
#   reg   (figuurlijk)      register or usage
#   dom   (medisch)         subject field
#   geo   (België)          regional marker
# The default drops the purely grammatical ones, which are noise on a card,
# and keeps the ones that say something about when a word is used. Set it
# empty to keep everything. Dictionaries without these classes are
# unaffected - nothing is stripped that isn't explicitly marked.
#
# Note the source-language article is *not* governed by this: it is promoted
# onto the headword itself ("het huis"), since that is part of learning the
# noun rather than an annotation about it.
dict_strip_labels=gen,gram

# --- Dictionary structure -----------------------------------------------
#
# Every dicthtml-*.zip has the same outer shape (the Kobo firmware fixes
# that), but generators disagree about everything inside it: where the
# translation sits, whether senses are numbered, which half of an example is
# the foreign one. That shape is described by a *profile* - a handful of CSS
# selectors - rather than by branches in the parser, so a dictionary this
# project has never seen can be supported by writing a section here.
#
# You normally need none of this: the profile is detected from the markup at
# load time. `kobo-vocab -print-config` shows which one each dictionary
# resolved to, and `-test-dict dict/dicthtml-nl-de.zip` prints the profile in
# the syntax below, ready to paste and adjust.
#
# Built-in profiles:
#   vandale   this project's own build (see CLASSES.md next to the dict
#             extractor): numbered senses, class="tr" translations,
#             class="ex" example blocks. Everything is marked, so nothing
#             has to be guessed - the shape to aim for if you generate a
#             dictionary yourself.
#   flat      conversions from StarDict and friends: a header, a <br>, and
#             the gloss. No markup at all, so the translation is found by
#             position.
#   nested    numbered senses and nothing else marked.
#   wikdict   WikDict's generated dicts (https://download.wikdict.com).
#   auto      detect (the default - same as writing no section).
#   custom    start from nothing and state every selector yourself.
#
# A section is keyed by language pair, matching the dicthtml-xx-yy.zip file
# name. Naming a base profile and then overriding one selector is fine; the
# rest of the base is kept.
#
# [dict:nl-de]
# profile=vandale
#
# [dict:de-fr]
# profile=custom
# sense=ol > li                 # what to loop over; omit if entries are flat
# translation=b.tr | div > i    # fallback chain, first match wins
# translation_reject=font.grammar  # matched inside a candidate = not a translation
# example=div.ex ul li
# example_target=span.t         # which half of the example is the target language
# article=i.art                 # source-language article, promoted onto the headword
# drop_tags=med,sport           # inline subject markers to delete before reading text
# split_on=;                    # extra separator between translations, besides ","
#
# The selector language is a small CSS subset and nothing more: tag names,
# ".class", descendant and ">" child combinators, and ":nth-of-type(n)".
# Selectors are relative to their scope - sense within the entry, everything
# else within the sense. A selector that matches nothing yields no entries
# rather than an error, so check with -test-dict after editing.

[nl]
# Any of max_senses/max_depth/max_chars can also be set per language,
# overriding the global defaults above for words from this language only
# (e.g. a language whose dict glosses run longer might want a higher
# max_chars here). Uncomment to try:
# max_senses=2
# max_chars=200
#
# translation_tag=b: for dictionaries with rich nested entries (multiple
# senses, grammar/gender annotations, usage notes - e.g. the nl-de dict),
# keep only the text wrapped in <b> and drop everything else, rather than
# showing the full formatted definition. Verified against dicthtml-nl-de.zip:
# that dict consistently bolds the actual German translation and italicizes
# the Dutch gloss/grammar notes, so this reduces clutter like "*(die*)"
# gender tags down to just the translation word(s). Has no effect on
# flat-format dicts (e.g. nl-en), where <b> wraps the repeated headword
# instead - those are left as full text. Comment out to see full definitions
# again.
#
# This is per-language, which is the wrong granularity: nl-de and nl-en are
# both "nl" but need different answers. It is kept because it works, and is
# used as the last fallback in a profile's translation chain - so a dict that
# marks its translations properly is preferred and one that only bolds them
# still works. A [dict:nl-de] section is the precise way to say the same
# thing.
translation_tag=b
#
# dict_examples=true: build a ChatGPT/Lexicala-style card (bold headword +
# alternatives + one example, on both the front and back) straight from the
# dict's own example phrases, instead of the plain translation list above.
# Off by default. It needs the translations individually - one becomes the
# headword, the rest alternatives - so it only applies to a dictionary whose
# profile can tell them apart; a flat dict, which finds its gloss by
# position, is left as a plain definition rather than having a card invented
# from comma-splitting it. Words the dict doesn't illustrate with an example
# (common for rarer vocabulary) still get a themed card, just without the
# example. Check a few entries with `kobo-vocab -test-dict` first.
# dict_examples=true
reduce_double=true
strip=en
strip=s
strip=e
strip=ft>ven
strip=t>den
strip=t>ten
strip=t>en
strip=t
strip=je
strip=tje
strip=pje
strip=ende
strip=ende>en
strip=ing>en
strip=de>en
strip=d>en
prefix_strip=ge
prefix_strip=in
prefix_strip=uit

[de]
reduce_double=true
strip=en
strip=e
strip=er
strip=es
strip=em
strip=n
strip=s
strip=t
strip=st
strip=t>en
strip=ung
strip=ung>en
prefix_strip=ge

[fr]
strip=s
strip=e
strip=es
strip=ent
strip=ent>er
strip=ait>er
strip=aient>er
strip=ant>er
strip=é>er
strip=ée>er
strip=és>er
strip=ées>er
